# Stripe — https://dashboard.stripe.com/apikeys (commence en mode test : sk_test_…)
STRIPE_SECRET_KEY=
# Secret du webhook Stripe (endpoint : https://<domaine>/api/webhooks/stripe, événement checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# HubSpot — formulaire « Cours personnalisé » (champs : firstname, lastname, email, phone, city, message)
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=

# Adresse publique du site (utilisée si l'en-tête Origin manque)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
